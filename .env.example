# =================================================================
# Candidate Screening System Configuration
# =================================================================

# GitHub Token (Optional, recommended for large batches to avoid 60 req/hr rate limits)
# Create a free personal access token at https://github.com/settings/tokens (no special scopes needed for public data)
GITHUB_TOKEN=

# LLM Provider Configuration (Optional)
# Supported options: "auto", "openai", "gemini", "heuristic"
# If no API key is provided, the system seamlessly uses a high-precision deterministic heuristic engine.
LLM_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Execution Settings
CONCURRENCY_LIMIT=5
DEFAULT_INPUT_DIR=./resumes
DEFAULT_OUTPUT_FILE=./output/results.json
